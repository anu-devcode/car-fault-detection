{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "production-release/**"
    ],
    "buildCommand": "python scripts/deployment_guard.py"
  },
  "deploy": {
    "startCommand": "gunicorn -w 1 -k uvicorn.workers.UvicornWorker backend:app --bind 0.0.0.0:$PORT --timeout 120",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1,
    "healthcheckPath": "/health"
  }
}
