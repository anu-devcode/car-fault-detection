# Backend. Relative defaults use the working directory; launch from the checkout root.
# CAR_FAULT_PROJECT_ROOT=/absolute/path/to/car-fault-detection
# DATASET_DIR=/absolute/path/to/audio-dataset
# MODELS_DIR=/absolute/path/to/validated-model-artifacts
# UNPROCESSED_DATA_DIR=/absolute/path/to/source-data
ALLOWED_ORIGINS=http://localhost:3000,https://car-fault-detection.vercel.app

# Optional development photo model, installed explicitly with scripts/install_vehicle_model.py
# VISION_MODEL_DIR=/absolute/path/to/models/vehicle-photo
# Local research-only audio adapter (default remains the bundled six-class CRNN)
# AUDIO_MODEL_BACKEND=research_ast
# ALLOW_RESEARCH_MODELS=true
# RESEARCH_AUDIO_MODEL_DIR=research/transfer-comparison
# HF_HOME=/absolute/path/to/your/hf-cache
